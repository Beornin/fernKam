# fernKam backend settings. `uv run fernkam setup-db` creates backend/.env from
# this file and fills in PG_URL for you; everything else is optional.
# Real environment variables override values in this file.

# ── Database ──────────────────────────────────────────────────────────────────
# The default matches docker-compose.yml. PG_URL_SYNC (psycopg2, used by
# migrations and backups) is derived from PG_URL unless you set it yourself.
PG_URL=postgresql+asyncpg://fernkam_user:fernkam@localhost:5432/fernkam
# PG_URL_SYNC=postgresql+psycopg2://fernkam_user:fernkam@localhost:5432/fernkam

# Set when the database runs in Docker, so Backup/Restore run pg_dump inside
# the container instead of needing a matching PostgreSQL client on this machine.
# PG_DOCKER_CONTAINER=fernkam-db

# Per-database planner settings, applied at startup with ALTER DATABASE (this
# database only). Use PG_RANDOM_PAGE_COST=4 if the database is on a spinning disk.
# PG_RANDOM_PAGE_COST=1.1
# PG_WORK_MEM=32MB
# PG_EFFECTIVE_CACHE_SIZE=24GB        # ~50-75% of RAM; unset by default

# ── Library ───────────────────────────────────────────────────────────────────
# The folder that holds your photos. Album paths are stored relative to it.
LIBRARY_ROOT=D:/Path/To/Your/Photos

# Relative paths are resolved against backend/.
# THUMB_CACHE_DIR=data/thumbnails
# BACKUP_DIR=data/backups

# Folder names used by the sorting pipeline and duplicate auto-clean.
# RAW_INTAKE_FOLDER=AA_RAW
# DEDUP_STAGING_FOLDERS=AB_TO_SORT,AC_SORTED
# DEDUP_ARCHIVE_FOLDER=Ordered by Dates
# PORTFOLIO_FOLDER=Portfolio
# PURERAW_EXE=C:/Program Files/DxO/DxO PureRAW 6/PureRAWv6.exe   # for Develop with DxO PureRAW

# ── External tools (found on PATH if unset) ───────────────────────────────────
# EXIFTOOL_PATH=C:/Tools/exiftool.exe
# FFMPEG_PATH=C:/Tools/ffmpeg/bin/ffmpeg.exe

# ── Face recognition ──────────────────────────────────────────────────────────
# The auto-confirm threshold is the sensitivity slider on the Settings page.
# SUGGEST_THRESH=0.5          # min similarity to suggest a person
# KNN_K=15                    # confirmed neighbours consulted per face
# KNN_MIN_VOTES=2
# MIN_REF_SCORE=0.55          # confirmed faces below this aren't used as references
# MIN_DET_SCORE=0.5           # drop detections below this confidence (0 = off)
# MIN_FACE_PX=30              # drop faces smaller than this
# MIN_BLUR_SCORE=10           # drop blurrier faces (Laplacian variance, 0 = off)
# PERSON_MIN_DATES={"Alice": "2018-03-22"}   # no suggestions before someone's birth

# FERNKAM_FACE_GPU=1          # 0 = force CPU for face detection
# FERNKAM_CLIP_GPU=1          # 0 = force CPU for CLIP (semantic search)
# FERNKAM_EMBED_BATCH=8       # images per GPU call for Tag Review models (default per model)
# FERNKAM_FACE_DET_SIZE=416   # detector input size; larger finds smaller faces, slower
# FERNKAM_FACE_CONCURRENCY=8  # photos decoded in parallel during face scans (default: CPU count, min 4)
# FERNKAM_FACE_WORKERS=1      # inference threads; keep 1 on GPU
# FERNKAM_THUMB_CONCURRENCY=8 # thumbnail workers during import (default: CPU count, min 4)
# FERNKAM_CLIP_DIR=E:/models/clip  # CLIP model download dir (~600 MB); default data/models/clip

# ── Staying in sync with the files ────────────────────────────────────────────
# SCAN_ON_STARTUP=true        # refresh from disk in the background at every start
# WATCH_LIBRARY=true          # pick up outside edits while fernKam is running
# WATCH_LIBRARY_POLLING=false # for network shares without change notifications

# ── Tag Review: local vision model ────────────────────────────────────────────
# Double-checks tag suggestions. Ollama's API by default; a URL ending in /v1 is
# any OpenAI-compatible server (LM Studio, llama.cpp). Photos are sent there.
# VISION_URL=http://127.0.0.1:11434
# VISION_MODEL=qwen3-vl:32b    # empty = best vision model the server has (largest of the newest family)

# ── Tag Review: species range priors ──────────────────────────────────────────
# GBIF's public API (no key). Only aggregate record counts are fetched, for
# 3°×3° boxes around the 1° cells your photos were taken in.
# GBIF_URL=https://api.gbif.org/v1

# ── Server ────────────────────────────────────────────────────────────────────
# The API has no login. Browser requests that change data are only accepted
# from this machine or from the address the server was reached on; list any
# other origin you use here (comma-separated).
# CORS_ORIGINS=http://my-other-machine:5173
# DEBUG=false                 # true enables /api/debug and SQL echo
# FERNKAM_LOG_DB_LEVEL=WARNING       # min level stored in the in-app Logs page
# FERNKAM_LOG_RETENTION_DAYS=30
# FERNKAM_LOG_CAPTURE_STDERR=1

# ── digiKam import (one-time migration only) ──────────────────────────────────
# MYSQL_URL=mysql+pymysql://root@localhost:3306/digikam
